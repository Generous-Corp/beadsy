      ],
      "result": "Procedural v2 knob calibration and 24-control capture are present; photo/panel pixel diff and rights-cleared full-panel comparison remain open."
    },
    {
      "id": "automation-and-modulation",
      "status": "partial",
      "evidence": [
        "provenance/editor-automation-gesture.json",
        "provenance/modulation-status.json"
